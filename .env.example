# Shared secret used to authenticate clients. Set this to a long random string.
ACCESS_KEY=

# Optional bind settings
# PORT=1111         # UI port (override: npm run start -- --PORT=1111)
# SERVER_PORT=1928  # API server port (override: npm run start -- --SERVER_PORT=1928)
# Set to true to allow access from other devices on the local network (e.g. phone).
# Default is false — only the machine running the server can connect.
# OVER_NETWORK=false
