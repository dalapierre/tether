        "start": "NODE_ENV=production tsx src/index.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@tether/core": "*",
        "@tether/ui": "*",
        "cors": "^2.8.5",
        "dotenv": "^18.0.5",
        "express": "^5.1.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.13",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.6.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@types/ws": "^8.18.2",
        "@vitejs/plugin-react": "^5.0.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "tailwindcss": "^4.1.13",
        "tsx": "^4.20.5",
        "typescript": "^5.9.3",
        "vite": "^7.1.7"
    }
